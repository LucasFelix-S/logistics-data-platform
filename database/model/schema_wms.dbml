/*
  Schema: WMS (Warehouse Management System)
  Informação: Todos os comentários adicionados manualmente como mecanismo de referência para a criação da seed para o banco de dados.
*/

/*=================================================================
  Tabelas de Cadastro
===============================================================*/
Table wms.produtos {
  codigo int [pk, increment]
  descricao varchar [not null]
  unidade_medida char(2) [not null]
  estoque_minimo int
  estoque_maximo int
  categoria_id int [ref: > wms.categorias.id, not null]
  status_id int [ref: > wms.status.id, not null]
  checks {
    `estoque_minimo IS NULL OR estoque_minimo >= 0` [name: 'ck_wms_produto_estoque_minimo']
    `estoque_maximo IS NULL OR estoque_maximo >= 0` [name: 'ck_wms_produto_estoque_maximo']
    `estoque_minimo IS NULL OR estoque_maximo IS NULL OR estoque_minimo <= estoque_maximo` [name: 'ck_wms_produto_faixa_estoque']
  }
} //-> Tabela cadastral dos produtos

Table wms.categorias {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de categorias dos produtos
/*
Tipos de categoria:
1 - Bebida
2 - Medicamento
3 - Alimento
4 - Produto de Limpeza
5 - Higiene Pessoal
6 - Material de Escritório
7 - Material de Construção
8 - Eletrônico
9 - Vestuário
10 - Calçados 
*/

Table wms.status {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de status dos produtos
/*
Tipos de Status:
1 - Ativo
2 - Inativo
3 - Bloqueado
*/

Table wms.localizadores {
  id int [pk, increment]
  descricao varchar [not null]
  corredor varchar [not null]
  modulo varchar [not null]
  nivel varchar [not null]
  tipo_localizador_id int [ref: > wms.tipos_localizadores.id, not null]
} //-> Tabela de localizadores
/*
Exemplos de localizadores
Corredor: A, Módulo: 01, Nível: 01, Tipo: Pallet, Descricao: A0101
*/

Table wms.tipos_localizadores {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de tipos de localizadores
/*
Tipos de Localizadores:
1 - Pallet
2 - Picking
3 - Área de Recebimento
*/

/*=================================================================
  Tabela de Estoque
===============================================================*/
Table wms.estoque {
  id int [pk, increment]
  produto_id int [ref: > wms.produtos.codigo, not null]
  localizador_id int [ref: > wms.localizadores.id, not null]
  lote varchar
  validade date
  quantidade int [not null]
  indexes {
    (produto_id, localizador_id, lote) [unique, name: 'uq_wms_estoque_produto_local_lote']
  }
  checks {
    `quantidade >= 0` [name: 'ck_wms_estoque_quantidade_nao_negativa']
  }
} //-> Tabela de estoque dos produtos

/*=================================================================
  Tabelas de Movimentações
===============================================================*/
Table wms.movimentacoes {
  id int [pk, increment]
  produto_id int [ref: > wms.produtos.codigo, not null]
  lote varchar
  validade date
  quantidade int [not null]
  localizador_origem int [ref: > wms.localizadores.id]
  localizador_destino int [ref: > wms.localizadores.id]
  tipo_movimentacao_id int [ref: > wms.tipos_movimentacoes.id, not null]
  data_movimentacao datetime [not null]
  checks {
    `quantidade > 0` [name: 'ck_wms_movimentacao_quantidade_positiva']
    `localizador_origem IS NULL OR localizador_destino IS NULL OR localizador_origem <> localizador_destino` [name: 'ck_wms_movimentacao_localizadores_distintos']
  }
} //-> Tabela de movimentações dos produtos

Table wms.tipos_movimentacoes {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de tipos de movimentações
/*
Tipos de Movimentações:
1 - Entrada
2 - Saída
3 - Separação
4 - Inventário
5 - Transferência
6 - Devolução
7 - Expedição
8 - Recebimento
*/

/*===============================================================
Tabelas de Entidades
===============================================================*/
Table wms.entidades {
  id int [pk, increment]
  nome varchar [not null]
  tipo_entidade_id int [ref: > wms.tipos_entidades.id, not null]
} //-> Tabela de entidades (clientes, fornecedores, transportadoras)

Table wms.tipos_entidades {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de tipos de entidades
/*
Tipos de Entidades:
1 - Cliente
2 - Fornecedor
3 - Transportadora
*/

/*===============================================================
Tabelas de Pedidos de Saída
===============================================================*/
Table wms.pedidos_saida {
  id int [pk, increment]
  pedido_venda_erp_id int [not null]
  data_pedido datetime [not null]
  entidade_id int [not null, ref: > wms.entidades.id]
  status_pedido_id int [not null, ref: > wms.status_pedidos.id]
} //-> Tabela de pedidos de saída

Table wms.status_pedidos {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de status dos pedidos
/*
Tipos de Status dos Pedidos:
1 - Pendente
2 - Em Processamento
3 - Concluído
4 - Cancelado
*/

Table wms.itens_pedidos {
  id int [pk, increment]
  pedido_id int [ref: > wms.pedidos_saida.id, not null]
  produto_id int [ref: > wms.produtos.codigo, not null]
  quantidade int [not null]
  indexes {
    (pedido_id, produto_id) [unique, name: 'uq_wms_pedido_produto']
  }
  checks {
    `quantidade > 0` [name: 'ck_wms_item_pedido_quantidade']
  }
} //-> Tabela de itens dos pedidos

Table wms.movimentacoes_pedidos {
  id int [pk, increment]
  pedido_id int [ref: > wms.pedidos_saida.id, not null]
  movimentacao_id int [ref: > wms.movimentacoes.id, not null]
  indexes {
    (pedido_id, movimentacao_id) [unique, name: 'uq_wms_mov_pedido']
  }
} //-> Tabela de movimentações relacionadas aos pedidos

/*===============================================================
Tabelas de Recebimento de Produtos
===============================================================*/
Table wms.recebimentos {
  id int [pk, increment]
  data_recebimento datetime [not null]
  entidade_id int [ref: > wms.entidades.id] 
  status_recebimento_id int [ref: > wms.status_recebimentos.id, not null]
} //-> Tabela de recebimentos

Table wms.status_recebimentos {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de status dos recebimentos
/*
Tipos de Status dos Recebimentos:
1 - Pendente
2 - Em Processamento
3 - Concluído
4 - Cancelado
*/

Table wms.itens_recebimentos {
  id int [pk, increment]
  recebimento_id int [ref: > wms.recebimentos.id, not null]
  produto_id int [ref: > wms.produtos.codigo, not null]
  lote varchar
  validade date
  quantidade_esperada int [not null]
  quantidade_confirmada int [not null]
  checks {
    `quantidade_esperada >= 0` [name: 'ck_wms_recebimento_qtd_esperada']
    `quantidade_confirmada >= 0` [name: 'ck_wms_recebimento_qtd_confirmada']
  }
} //-> Tabela de itens dos recebimentos

/*===============================================================
Alocação de Produtos em Localizadores para produtos do recebimento
===============================================================*/
Table wms.alocacoes {
  id int [pk, increment]
  recebimento_id int [ref: > wms.recebimentos.id, not null]
  produto_id int [ref: > wms.produtos.codigo, not null]
  localizador_id int [ref: > wms.localizadores.id, not null]
  lote varchar
  validade date
  quantidade int [not null]
  checks {
    `quantidade > 0` [name: 'ck_wms_alocacao_quantidade']
  }
} //-> Tabela de alocação de produtos em localizadores

Table wms.movimentacoes_alocacoes {
  id int [pk, increment]
  alocacao_id int [ref: > wms.alocacoes.id, not null]
  movimentacao_id int [ref: > wms.movimentacoes.id, not null]
  indexes {
    (alocacao_id, movimentacao_id) [unique, name: 'uq_wms_mov_alocacao']
  }
} //-> Tabela de movimentações relacionadas às alocações

/*===============================================================
Tabelas de Expedição
===============================================================*/
Table wms.expedicoes {
  id int [pk, increment]
  data_expedicao datetime [not null]
  pedido_id int [ref: > wms.pedidos_saida.id, not null]
  status_expedicao_id int [ref: > wms.status_expedicoes.id, not null]
} //-> Tabela de expedições

Table wms.status_expedicoes {
  id int [pk, increment] 
  descricao varchar [not null]
} //-> Tabela de status das expedições
/*
Tipos de Status das Expedições:
1 - Pendente
2 - Em Processamento
3 - Concluído
4 - Cancelado 
*/

Table wms.itens_expedicoes {
  id int [pk, increment]
  expedicao_id int [ref: > wms.expedicoes.id, not null]
  produto_id int [ref: > wms.produtos.codigo, not null]
  lote varchar
  validade date
  quantidade_esperada int [not null]
  quantidade_confirmada int [not null]
  checks {
    `quantidade_esperada >= 0` [name: 'ck_wms_expedicao_qtd_esperada']
    `quantidade_confirmada >= 0` [name: 'ck_wms_expedicao_qtd_confirmada']
  }
} //-> Tabela de itens das expedições

Table wms.movimentacoes_expedicoes {
  id int [pk, increment]
  expedicao_id int [ref: > wms.expedicoes.id, not null]
  movimentacao_id int [ref: > wms.movimentacoes.id, not null]
  indexes {
    (expedicao_id, movimentacao_id) [unique, name: 'uq_wms_mov_expedicao']
  }
} //-> Tabela de movimentações relacionadas às expedições

/*===============================================================
Tabelas de Inventário
===============================================================*/
Table wms.inventarios {
  id int [pk, increment]
  data_inventario datetime [not null]
  status_inventario_id int [ref: > wms.status_inventarios.id, not null]
} //-> Tabela de inventários

Table wms.status_inventarios {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de status dos inventários
/*
Tipos de Status dos Inventários:
1 - Pendente
2 - Em Processamento
3 - Concluído
4 - Cancelado
*/

Table wms.itens_inventarios {
  id int [pk, increment]
  inventario_id int [ref: > wms.inventarios.id, not null]
  produto_id int [ref: > wms.produtos.codigo, not null]
  localizador_id int [ref: > wms.localizadores.id, not null]
  lote varchar
  validade date
  quantidade_congelada int [not null]
  quantidade_contada int [not null]
  checks {
    `quantidade_congelada >= 0` [name: 'ck_wms_inventario_qtd_congelada']
    `quantidade_contada >= 0` [name: 'ck_wms_inventario_qtd_contada']
  }
} //-> Tabela de itens dos inventários

Table wms.movimentacoes_inventarios {
  id int [pk, increment]
  inventario_id int [ref: > wms.inventarios.id, not null]
  movimentacao_id int [ref: > wms.movimentacoes.id, not null]
  indexes {
    (inventario_id, movimentacao_id) [unique, name: 'uq_wms_mov_inventario']
  }
}


