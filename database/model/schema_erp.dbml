/*
  Schema: ERP (Enterprise Resource Planning.)
  Informação: Todos os comentários adicionados manualmente como mecanismo de referência para a criação da seed para o banco de dados.
*/

/*=================================================================
  Tabelas de Cadastro
===============================================================*/
Table erp.produtos {
  codigo int [pk, increment]
  descricao varchar [not null]
  unidade_medida char(2) [not null]
  estoque_minimo int
  estoque_maximo int
  categoria_id int [ref: > erp.categorias.id, not null] 
  status_id int [ref: > erp.status.id, not null]
} //-> Tabela cadastral dos produtos

Table erp.categorias {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de categorias dos produtos
/*
Tipos de categoria:
1 - Bebida
2 - Medicamento
3 - Alimento
4 - Produto de Limpeza
5 - Higiene Pessoal
6 - Material de Escritório
7 - Material de Construção
8 - Eletrônico
9 - Vestuário
10 - Calçados 
*/

Table erp.status {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de status dos produtos
/*
Tipos de Status:
1 - Ativo
2 - Inativo
3 - Bloqueado
*/

Table erp.condicoes_pagamento {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de condições de pagamento

Table erp.parcelas_condicoes_pagamento {
  id int [pk, increment]
  condicao_pagamento_id int [ref: > erp.condicoes_pagamento.id, not null]
  numero_parcela int [not null]
  prazo_dias int [not null]
  percentual decimal(5,2) [not null]
  indexes {
    (condicao_pagamento_id, numero_parcela) [unique, name: 'uq_erp_condicao_numero_parcela']
  }
  checks {
    `numero_parcela > 0` [name: 'ck_erp_condicao_numero_parcela']
    `prazo_dias >= 0` [name: 'ck_erp_condicao_prazo']
    `percentual >= 0 AND percentual <= 100` [name: 'ck_erp_condicao_percentual']
  }
} //-> Tabela de parcelas das condições de pagamento

/*===============================================================
Tabelas de Entidades
===============================================================*/
Table erp.entidades {
  id int [pk, increment]
  nome varchar [not null]
  tipo_entidade_id int [ref: > erp.tipos_entidades.id, not null]
} //-> Tabela de entidades (clientes, fornecedores, transportadoras)

Table erp.tipos_entidades {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de tipos de entidades
/*
Tipos de Entidades:
1 - Cliente
2 - Fornecedor
3 - Transportadora
*/

/*===============================================================
Tabelas de Vendas
===============================================================*/
Table erp.pedidos_venda {
  id int [pk, increment]
  cliente_id int [ref: > erp.entidades.id, not null]
  data_pedido datetime [not null]
  status_id int [ref: > erp.status_pedidos_venda.id, not null]
  condicao_pagamento_id int [ref: > erp.condicoes_pagamento.id, not null]
  valor_total decimal(10,2) [not null]
  checks {
    `valor_total >= 0` [name: 'ck_erp_pedido_venda_valor_total']
  }
} //-> Tabela de pedidos de venda

Table erp.itens_pedidos_venda {
  id int [pk, increment]
  pedido_id int [ref: > erp.pedidos_venda.id, not null]
  produto_id int [ref: > erp.produtos.codigo, not null]
  quantidade int [not null]
  preco_unitario decimal(10,2) [not null]
  desconto decimal(5,2)
  checks {
    `quantidade > 0` [name: 'ck_erp_item_venda_quantidade']
    `preco_unitario >= 0` [name: 'ck_erp_item_venda_preco']
    `desconto IS NULL OR (desconto >= 0 AND desconto <= 100)` [name: 'ck_erp_item_venda_desconto_percentual']
  }
} //-> Tabela de itens dos pedidos de venda

Table erp.status_pedidos_venda {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de status dos pedidos de venda
/*
Tipos de Status dos Pedidos de Venda:
1 - Aberto
2 - Aprovado
3 - Faturado
4 - Cancelado
*/

Table erp.tabelas_preco {
  id int [pk, increment]
  nome varchar [not null]
  vigencia_inicio datetime [not null]
  vigencia_fim datetime
  status_id int [ref: > erp.status_tabelas_preco.id, not null]
} //-> Tabela de tabelas de preço

Table erp.status_tabelas_preco {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de status das tabelas de preço
/*
Tipos de Status das Tabelas de Preço:
1 - Ativa
2 - Inativa
3 - Expirada
4 - Cancelada
*/

Table erp.itens_tabelas_preco {
  id int [pk, increment]
  tabela_id int [ref: > erp.tabelas_preco.id, not null]
  produto_id int [ref: > erp.produtos.codigo, not null]
  preco decimal(10,2) [not null]
  indexes {
    (tabela_id, produto_id) [unique, name: 'uq_erp_tabela_preco_produto']
  }
  checks {
    `preco >= 0` [name: 'ck_erp_preco_nao_negativo']
  }
} //-> Tabela de itens das tabelas de preço


/*===============================================================
Tabelas de Compras
===============================================================*/
Table erp.pedidos_compra {
  id int [pk, increment]
  fornecedor_id int [ref: > erp.entidades.id, not null]
  data_pedido datetime [not null]
  status_id int [ref: > erp.status_pedidos_compra.id, not null]
  previsao_entrega datetime [not null]
} //-> Tabela de pedidos de compra

Table erp.itens_pedidos_compra {
  id int [pk, increment]
  pedido_id int [ref: > erp.pedidos_compra.id, not null]
  produto_id int [ref: > erp.produtos.codigo, not null]
  quantidade int [not null]
  custo_unitario decimal(10,2) [not null]
  checks {
    `quantidade > 0` [name: 'ck_erp_item_compra_quantidade']
    `custo_unitario >= 0` [name: 'ck_erp_item_compra_custo']
  }
} //-> Tabela de itens dos pedidos de compra

Table erp.status_pedidos_compra {
  id int [pk, increment]
  descricao varchar [not null]
} //-> Tabela de status dos pedidos de compra

/*===============================================================
Tabelas de Financeiro comercial
===============================================================*/
Table erp.contas_receber {
  id int [pk, increment]
  pedido_venda_id int [ref: > erp.pedidos_venda.id, not null]
  valor decimal(10,2) [not null]
  checks {
    `valor >= 0` [name: 'ck_erp_contas_receber_valor']
  }
} //-> Cabeçalho financeiro a receber; vencimentos e pagamentos ficam nas parcelas

Table erp.contas_pagar {
  id int [pk, increment]
  pedido_compra_id int [ref: > erp.pedidos_compra.id, not null]
  valor decimal(10,2) [not null]
  checks {
    `valor >= 0` [name: 'ck_erp_contas_pagar_valor']
  }
} //-> Cabeçalho financeiro a pagar; vencimentos e pagamentos ficam nas parcelas

Table erp.parcelas_receber {
  id int [pk, increment]
  numero_parcela int [not null]
  conta_receber_id int [ref: > erp.contas_receber.id, not null]
  valor decimal(10,2) [not null]
  vencimento datetime [not null]
  pagamento datetime
  indexes {
    (conta_receber_id, numero_parcela) [unique, name: 'uq_erp_parcela_receber_numero']
  }
  checks {
    `numero_parcela > 0` [name: 'ck_erp_parcela_receber_numero_check']
    `valor >= 0` [name: 'ck_erp_parcela_receber_valor']
  }
} //-> Tabela de parcelas a receber

Table erp.parcelas_pagar {
  id int [pk, increment]
  numero_parcela int [not null]
  conta_pagar_id int [ref: > erp.contas_pagar.id, not null]
  valor decimal(10,2) [not null]
  vencimento datetime [not null]
  pagamento datetime
  indexes {
    (conta_pagar_id, numero_parcela) [unique, name: 'uq_erp_parcela_pagar_numero']
  }
  checks {
    `numero_parcela > 0` [name: 'ck_erp_parcela_pagar_numero_check']
    `valor >= 0` [name: 'ck_erp_parcela_pagar_valor']
  }
} //-> Tabela de parcelas a pagar


